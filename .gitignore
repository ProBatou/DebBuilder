# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/

# JavaScript dependencies
node_modules/

# Local configuration and secrets
.env
.env.*
!.env.example
secrets/
credentials/

# Runtime state. Recipes are project data and remain versioned.
data/*

{
  "name": "debbuilder-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs && node tests/browser-recipe-editor.mjs && node tests/browser-package-lifecycle.mjs",
    "build": "vite build",
    "test:browser:save": "node tests/browser-recipe-save.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.1",
    "svelte-check": "4.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}

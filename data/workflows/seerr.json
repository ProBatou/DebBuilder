{
  "schema_version": 1,
  "name": "seerr",
  "active": true,
  "package": {
    "name": "seerr",
    "version_revision": "2",
    "architecture": "amd64",
    "section": "web",
    "priority": "optional",
    "maintainer": "Jesse Chan <jc@linux.com>",
    "description": "media request and discovery manager",
    "runtime_dependencies": [
      "nodejs"
    ]
  },
  "source": {
    "provider": "github",
    "repository": "seerr-team/seerr",
    "tracking": "latest_release",
    "ref": "",
    "version": {
      "source": "tag",
      "expression": ""
    }
  },
  "artifact": {
    "mode": "source_build",
    "type": "deb",
    "architecture": "amd64",
    "name_pattern": "",
    "match_package": true,
    "match_version": true
  },
  "build": {
    "detected_project": "nodejs",
    "detected_files": [
      "package.json",
      "pnpm-lock.yaml"
    ],
    "detected_dependencies": [
      "nodejs"
    ],
    "extra_dependencies": [],
    "source_changes": [],
    "commands": [
      "corepack prepare pnpm@10.24.0 --activate",
      "pnpm install --frozen-lockfile",
      "pnpm build",
      "pnpm prune --prod --ignore-scripts"
    ],
    "timeout": 900,
    "environment": {
      "CYPRESS_INSTALL_BINARY": "0"
    },
    "working_directory": ".",
    "output": {
      "mode": "paths",
      "paths": [
        "package.json",
        "next.config.ts",
        "node_modules",
        ".next",
        "dist",
        "public",
        "seerr-api.yml"
      ]
    }
  },
  "install": {
    "destination": "/opt/seerr",
    "content": {
      "source": "build_output",
      "path": ""
    },
    "owner": {
      "user": "seerr",
      "group": "seerr",
      "create_user": true,
      "create_group": true
    },
    "directory_mode": "0755",
    "file_mode": "0644",
    "config_files": [],
    "maintainer_scripts": {
      "preinst": "",
      "postinst": "install -d -m 0750 -o seerr -g seerr /var/lib/seerr\ninstall -d -m 0750 -o seerr -g seerr /var/lib/seerr/db",
      "prerm": "",
      "postrm": ""
    }
  },
  "service": {
    "enabled": true,
    "name": "seerr.service",
    "description": "Seerr media request manager",
    "type": "exec",
    "user": "seerr",
    "group": "seerr",
    "restart": "on-failure",
    "command": "/usr/bin/node /opt/seerr/dist/index.js",
    "environment_files": [],
    "environment": {
      "NODE_ENV": "production",
      "CONFIG_DIRECTORY": "/var/lib/seerr"
    },
    "after": [
      "network-online.target"
    ],
    "wants": [
      "network-online.target"
    ],
    "requires": [],
    "restart_sec": "",
    "timeout_start_sec": "",
    "timeout_stop_sec": "",
    "kill_signal": "",
    "exec_start_pre": [],
    "exec_start_post": [],
    "exec_stop": [],
    "standard_output": "journal",
    "standard_error": "journal",
    "working_directory": "/opt/seerr"
  },
  "steps": []
}

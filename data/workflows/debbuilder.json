{
  "schema_version": 1,
  "name": "debbuilder",
  "active": true,
  "package": {
    "name": "debbuilder",
    "version_revision": "2",
    "architecture": "all",
    "section": "admin",
    "priority": "optional",
    "maintainer": "ProBatou <baptiste2105@hotmail.fr>",
    "description": "web interface for reproducible Debian package pipelines",
    "runtime_dependencies": [
      "python3",
      "ca-certificates",
      "dpkg",
      "reprepro",
      "podman",
      "gnupg"
    ]
  },
  "source": {
    "provider": "github",
    "repository": "ProBatou/DebBuilder",
    "tracking": "latest_release",
    "ref": "",
    "version": {
      "source": "tag",
      "expression": ""
    }
  },
  "artifact": {
    "mode": "source_build",
    "type": "deb",
    "architecture": "all",
    "name_pattern": "",
    "match_package": true,
    "match_version": true
  },
  "build": {
    "detected_project": "python",
    "detected_files": [
      "server.py",
      "debbuilder/__init__.py"
    ],
    "detected_dependencies": [],
    "extra_dependencies": [],
    "source_changes": [],
    "commands": [],
    "timeout": 120,
    "environment": {},
    "working_directory": ".",
    "output": {
      "mode": "paths",
      "paths": [
        "debbuilder",
        "server.py",
        "static"
      ]
    }
  },
  "install": {
    "destination": "/opt/debbuilder",
    "content": {
      "source": "build_output",
      "path": ""
    },
    "owner": {
      "user": "root",
      "group": "root",
      "create_user": false,
      "create_group": false
    },
    "directory_mode": "0755",
    "file_mode": "0644",
    "config_files": [
      {
        "source": "packaging/debbuilder.env",
        "destination": "/etc/debbuilder/debbuilder.env",
        "policy": "create_if_missing"
      }
    ],
    "maintainer_scripts": {
      "preinst": "install -d -m 0751 -o root -g root /var/lib/debbuilder\ninstall -d -m 0750 -o root -g root /var/lib/debbuilder/workflows /var/lib/debbuilder/runs /var/lib/debbuilder/builds /var/lib/debbuilder/build-workspaces\ninstall -d -m 0751 -o root -g root /var/lib/debbuilder/repository\ninstall -d -m 0700 -o root -g root /var/lib/debbuilder/.gnupg",
      "postinst": "",
      "prerm": "",
      "postrm": "if [ \"$1\" = purge ]; then\n  rm -rf -- /var/lib/debbuilder\nfi"
    }
  },
  "service": {
    "enabled": true,
    "name": "debbuilder.service",
    "description": "DebBuilder Debian package pipeline",
    "type": "simple",
    "user": "root",
    "group": "root",
    "restart": "on-failure",
    "command": "/usr/bin/python3 /opt/debbuilder/server.py",
    "environment_files": [
      "-/etc/debbuilder/debbuilder.env"
    ],
    "environment": {},
    "after": [
      "network-online.target"
    ],
    "wants": [
      "network-online.target"
    ],
    "requires": [],
    "restart_sec": "3",
    "timeout_start_sec": "",
    "timeout_stop_sec": "",
    "kill_signal": "",
    "exec_start_pre": [],
    "exec_start_post": [],
    "exec_stop": [],
    "standard_output": "journal",
    "standard_error": "journal",
    "working_directory": "/opt/debbuilder"
  },
  "steps": []
}

        "source": "packaging/debbuilder.env",
        "destination": "/etc/debbuilder/debbuilder.env",
        "policy": "create_if_missing"
      }
    ],
    "maintainer_scripts": {
      "preinst": "install -d -m 0751 -o root -g root /var/lib/debbuilder\ninstall -d -m 0750 -o root -g root /var/lib/debbuilder/workflows /var/lib/debbuilder/builds\ninstall -d -m 0751 -o root -g root /var/lib/debbuilder/repository\ninstall -d -m 0700 -o root -g root /var/lib/debbuilder/.gnupg",
      "postinst": "",
      "prerm": "",
      "postrm": ""
    }
  },
  "service": {
    "enabled": true,

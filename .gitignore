/runs/
/workflows/
/package-sources/
/source/
/staging/
/artifacts/
/dist/
/validation/runtime/

# Generated Debian artifacts and runtime logs
*.deb
*.ddeb
*.changes
*.buildinfo
*.dsc
*.orig.tar.*
*.debian.tar.*
*.log
*.out

# Editor and operating-system files
.DS_Store
